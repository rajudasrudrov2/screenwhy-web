# ScreenWhy public-site origin used by canonical/absolute URL helpers.
# Keep localhost while developing. Set https://screenwhy.com in production.
SCREENWHY_SITE_URL=http://localhost:3000

# Server-safe headless CMS REST base. No credentials belong here.
# cms.screenwhy.com is the expected future hostname convention only; this
# migration does NOT verify DNS or a live CMS. The generic API client appends
# the legacy internal /plotexplainer/v1 namespace until backend migration decides otherwise.
SCREENWHY_CMS_API_BASE_URL=https://cms.screenwhy.com/wp-json

# Frontend data source. Supported values are EXACTLY: mock | api
# Local development defaults safely to mock when omitted.
# Production repository access requires an explicit value.
# API mode intentionally fails with BackendContractNotReady and never falls
# back to mock content until the authoritative backend response contract exists.
SCREENWHY_DATA_SOURCE=mock

# Safe default for local/preview/staging. Production indexing must be enabled
# explicitly only when the public deployment is ready.
SCREENWHY_ALLOW_INDEXING=false

# Temporary compatibility fallbacks (legacy names; remove in a later migration
# only after deployment/backend configuration has been audited):
# PLOTEXPLAINER_SITE_URL=http://localhost:3000
# PLOTEXPLAINER_CMS_API_BASE_URL=https://cms.screenwhy.com/wp-json
# PLOTEXPLAINER_DATA_SOURCE=mock
# PLOTEXPLAINER_ALLOW_INDEXING=false
