{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".data-validation",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": [
    "scripts/validate-data-foundation.ts",
    "src/config/api.ts",
    "src/config/env.ts",
    "src/config/routes.ts",
    "src/data/**/*.ts",
    "src/lib/http/**/*.ts",
    "src/lib/i18n/**/*.ts",
    "src/services/api/client.ts",
    "src/types/domain/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".data-validation"]
}
