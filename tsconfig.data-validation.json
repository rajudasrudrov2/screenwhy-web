{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".data-validation",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": [
    "scripts/validate-data-foundation.ts",
    "src/config/api.ts",
    "src/config/env.ts",
    "src/config/routes.ts",
    "src/data/**/*.ts",
    "src/lib/http/**/*.ts",
    "src/lib/i18n/**/*.ts",
    "src/services/api/client.ts",
    "src/types/domain/**/*.ts",
    "scripts/validate-homepage-data.ts",
    "src/features/homepage/homepage.loader.ts",
    "src/features/homepage/homepage.config.ts",
    "src/features/homepage/homepage.types.ts",
    "scripts/validate-title-hub-data.ts",
    "src/features/title-hub/title-hub.loader.ts",
    "src/features/title-hub/title-hub.types.ts",
    "scripts/validate-character-detail-data.ts",
    "src/features/character-detail/character-detail.loader.ts",
    "src/features/character-detail/character-detail.types.ts",
    "scripts/validate-search-data.ts",
    "src/features/search/search.loader.ts",
    "src/features/search/search.types.ts",
    "src/features/search/search.utils.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".data-validation"
  ]
}
